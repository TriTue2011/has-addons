        <tr><th>Field</th><th>Loại</th><th>Mô tả</th><th>Bắt buộc</th></tr>
        <tr>
          <td>userId</td>
          <td>string</td>
          <td>ID của người dùng nhận lời mời.</td>
          <td>Có</td>
        </tr>
        <tr>
          <td>ownId</td>
          <td>string</td>
          <td>ID tài khoản Zalo đang đăng nhập (lấy từ /accounts).</td>
          <td>Có</td>
        </tr>
    </table>
    <p><strong>Ví dụ:</strong></p>
    <pre>
{
  "userId": "0000000000000000002",
